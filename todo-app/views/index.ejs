<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do List</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <h1>To-Do List</h1>
        <ul>
            <% tasks.forEach(task => { %>
                <li class="task-item">
                    <form action="/complete-task" method="POST">
                        <input type="hidden" name="id" value="<%= task.id %>">
                        <button type="submit" class="check-btn">
                            <span class="checkbox"><%= task.completed ? "✔️" : "⬜" %></span>
                        </button>
                    </form>

                    <span class="task-title <%= task.completed ? 'completed' : '' %>">
                        <%= task.title %>
                    </span>

                    <form action="/delete-task" method="POST">
                        <input type="hidden" name="id" value="<%= task.id %>">
                        <button type="submit" class="delete-btn">🗑️</button>
                    </form>
                </li>
            <% }); %>
        </ul>

        <h2>Add a Task</h2>
        <form action="/add-task" method="POST" class="add-task-form">
            <input type="text" name="title" required placeholder="Enter a task...">
            <button type="submit" class="add-btn">Add Task</button>
        </form>
    </div>
</body>
</html>
